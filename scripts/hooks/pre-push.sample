#!/bin/sh
# Optional: copy to the path from `git rev-parse --git-path hooks/pre-push`.
# Keep scripts/leak-scan.py in the adopting repository; configure a private
# external patterns file via LEAK_SCAN_PATTERNS or git config leakscan.patterns.
# Git supplies ref updates on stdin and the destination remote name/URL as arguments.
repo_root=$(GIT_NO_LAZY_FETCH=1 git --no-replace-objects rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' 'ERROR leak-scan: could not locate repository' >&2
    exit 2
}
scanner="$repo_root/scripts/leak-scan.py"
# Check first: the shell's and Python's own startup errors would print this
# repository's path, which may itself be private.
if ! command -v python3 >/dev/null 2>&1 || [ ! -r "$scanner" ]; then
    printf '%s\n' 'ERROR leak-scan: scanner or python3 unavailable' >&2
    exit 2
fi
exec python3 -B "$scanner" "$@"
